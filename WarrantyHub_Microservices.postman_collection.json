{
  "info": {
    "_postman_id": "f62a5fd2-5e46-4a4a-85c3-microservices",
    "name": "WarrantyHub Microservices API",
    "description": "Gateway-based WarrantyHub microservices workflow. Run requests in order. The first request creates unique emails and later requests reuse collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "companyToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "purchaseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "companyEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "password123",
      "type": "string"
    },
    {
      "key": "invoiceNumber",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Setup & Company",
      "item": [
        {
          "name": "1. Create Company",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now();",
                  "pm.collectionVariables.set('companyEmail', `acme${suffix}@example.com`);",
                  "pm.collectionVariables.set('customerEmail', `asha${suffix}@example.com`);",
                  "pm.collectionVariables.set('invoiceNumber', `INV-${suffix}`);",
                  "pm.collectionVariables.unset('companyToken');",
                  "pm.collectionVariables.unset('customerToken');",
                  "pm.collectionVariables.unset('purchaseId');",
                  "pm.collectionVariables.unset('requestId');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('company created', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Acme Corp\",\n  \"email\": \"{{companyEmail}}\",\n  \"password\": \"{{password}}\",\n  \"phone\": \"9999999999\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/companies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "companies"
              ]
            }
          }
        },
        {
          "name": "2. Login Company",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('company login OK', function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.collectionVariables.set('companyToken', pm.response.text());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{companyEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "3. Create Purchase Bundle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('purchase bundle created', function () {",
                  "  pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('purchaseId', json.purchaseId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{companyToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Asha\",\n  \"customerEmail\": \"{{customerEmail}}\",\n  \"customerPhone\": \"8888888888\",\n  \"customerPassword\": \"{{password}}\",\n  \"productName\": \"SuperPhone\",\n  \"productCategory\": \"Mobile\",\n  \"modelNumber\": \"SP-100\",\n  \"warrantyPeriod\": 12,\n  \"warrantyUnit\": \"MONTHS\",\n  \"warrantyTerms\": \"Standard coverage\",\n  \"purchaseDate\": \"2026-08-16\",\n  \"invoiceNumber\": \"{{invoiceNumber}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/purchases",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "purchases"
              ]
            }
          }
        }
      ]
    },
